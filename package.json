{
  "name": "shipops-cicd-platform",
  "version": "1.0.0",
  "description": "Production Cloud-Native CI/CD Deployment Platform with Node.js, Docker, Kubernetes, Helm, PostgreSQL, Prometheus, and Grafana",
  "main": "dist/server.js",
  "bin": {
    "shipctl": "./bin/shipctl.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "shipctl": "tsx src/cli/shipctl.ts"
  },
  "keywords": [
    "cicd",
    "kubernetes",
    "helm",
    "docker",
    "prometheus",
    "grafana",
    "cloud-native",
    "devops"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AnujBehra/cloud-native-cicd-platform.git"
  },
  "author": "Anuj Behra",
  "license": "Apache-2.0",
  "dependencies": {
    "@kubernetes/client-node": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "uuid": "^11.0.5",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
