GIT_AUTH_TOKEN=
KUBECONFIG=
KUBE_CONTEXT=
APP_CHART_PATH=./helm/deployed-app
API_KEY=change-me-in-production
GITHUB_WEBHOOK_SECRET=replace-me
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
