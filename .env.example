# ShipOps Environment Configuration
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shipops
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Kubernetes & Docker
K8S_DEFAULT_NAMESPACE=shipops-apps
DOCKER_REGISTRY=registry.shipops.internal
GITHUB_WEBHOOK_SECRET=shipops-secret-token-12345
